{
    "name": "@nightshadeui/stylesheets",
    "version": "3.5.1",
    "description": "Nightshade styles: scales, context and roles as CSS variables, plus base and utilities",
    "author": "Boris Okunskiy",
    "license": "ISC",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./css.d.ts",
            "default": "./index.css"
        },
        "./palette.css": "./palette.css",
        "./scales/*": "./scales/*",
        "./settings/*": "./settings/*",
        "./roles/*": "./roles/*",
        "./context/*": "./context/*",
        "./base.css": "./base.css",
        "./utilities.css": "./utilities.css",
        "./kbd": {
            "types": "./css.d.ts",
            "default": "./modules/kbd/index.css"
        },
        "./transitions": {
            "types": "./css.d.ts",
            "default": "./modules/transitions/index.css"
        }
    },
    "scripts": {
        "palette": "nightshade palette -o palette.css"
    }
}
