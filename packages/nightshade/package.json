{
    "name": "nightshade",
    "version": "3.13.0",
    "description": "A seed for application-owned design systems: CSS variables first, Vue primitives optional",
    "author": "Boris Okunskiy",
    "license": "ISC",
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./index.d.ts",
            "import": "./index.mjs"
        },
        "./css": {
            "types": "./css.d.ts",
            "default": "./index.css"
        },
        "./vite": {
            "types": "./vite.d.mts",
            "import": "./vite.mjs"
        }
    },
    "dependencies": {
        "@nightshadeui/components": "3.13.0",
        "@nightshadeui/stylesheets": "3.13.0",
        "@nightshadeui/vite": "3.13.0"
    },
    "peerDependencies": {
        "vue": "^3.5.22"
    }
}
