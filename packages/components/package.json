{
    "name": "@nightshadeui/components",
    "version": "3.11.0",
    "description": "Standard Nightshade components: opt-in Vue primitives that read the styles",
    "author": "Boris Okunskiy",
    "license": "ISC",
    "sideEffects": [
        "*.css"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./css": {
            "types": "./css.d.ts",
            "default": "./dist/components.css"
        },
        "./src": "./src/index.ts"
    },
    "files": [
        "dist",
        "src",
        "css.d.ts"
    ],
    "scripts": {
        "build:watch": "vite build --watch",
        "build": "NODE_ENV=production vite build"
    },
    "peerDependencies": {
        "vue": "^3.5.22",
        "vue-router": "^4.6.4"
    },
    "peerDependenciesMeta": {
        "vue-router": {
            "optional": true
        }
    },
    "dependencies": {
        "@nightshadeui/util": "3.11.0",
        "@nightshadeui/stylesheets": "3.11.0"
    },
    "devDependencies": {
        "@nightshadeui/vite": "3.11.0"
    }
}
