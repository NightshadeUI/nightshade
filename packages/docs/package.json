{
    "name": "@nightshadeui/docs",
    "version": "3.2.0",
    "description": "A documentation site for design systems grown from Nightshade: a VitePress theme with a landing, navigation and live references that read your own styles",
    "author": "Boris Okunskiy",
    "license": "ISC",
    "type": "module",
    "sideEffects": [
        "*.css",
        "./src/index.ts"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./src": "./src/index.ts",
        "./config": {
            "types": "./out/helpers/define-docs-config.d.ts",
            "import": "./out/helpers/define-docs-config.js"
        },
        "./styles.css": "./src/styles/docs.css",
        "./hero-backdrop": "./src/components/HeroBackdrop.vue"
    },
    "files": [
        "src",
        "out/config",
        "out/helpers",
        "out/catalog",
        "!src/test"
    ],
    "scripts": {
        "build": "tsc -b",
        "test": "node --test \"out/test/**/*.test.js\""
    },
    "peerDependencies": {
        "@nightshadeui/particle-system": "3.2.0",
        "vitepress": "^2.0.0-alpha.21",
        "vue": "^3.5.22"
    },
    "peerDependenciesMeta": {
        "@nightshadeui/particle-system": {
            "optional": true
        }
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.3.1",
        "@nightshadeui/components": "3.2.0",
        "@nightshadeui/stylesheets": "3.2.0",
        "@nightshadeui/util": "3.2.0",
        "lightningcss": "^1.33.0",
        "shiki": "^4.6.0"
    }
}
