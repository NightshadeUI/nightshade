{
    "name": "@nightshadeui/docs",
    "version": "2.22.0",
    "description": "A documentation site for design systems grown from Nightshade: a VitePress theme with a landing, navigation and live references that read your own styles",
    "author": "Boris Okunskiy",
    "license": "ISC",
    "type": "module",
    "sideEffects": [
        "*.css",
        "./src/index.ts"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./src": "./src/index.ts",
        "./config": {
            "types": "./out/helpers/define-docs-config.d.ts",
            "import": "./out/helpers/define-docs-config.js"
        },
        "./styles.css": "./src/styles/docs.css"
    },
    "files": [
        "src",
        "out/config",
        "out/helpers",
        "out/catalog"
    ],
    "scripts": {
        "build": "tsc -b"
    },
    "peerDependencies": {
        "vitepress": "^2.0.0-alpha.17",
        "vue": "^3.5.22"
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^7.2.0",
        "@nightshadeui/components": "2.22.0",
        "@nightshadeui/particle-system": "2.22.0",
        "@nightshadeui/stylesheets": "2.22.0",
        "@nightshadeui/util": "2.22.0",
        "lightningcss": "^1.30.2",
        "shiki": "^3.23.0"
    }
}
