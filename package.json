{
    "name": "@nightshadeui/workspace",
    "version": "2.15.0",
    "description": "Scalable System for Vue",
    "private": true,
    "author": "Boris Okunskiy",
    "license": "ISC",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "run-p dev:*",
        "dev:gallery": "cd packages/gallery && npm run dev",
        "preview": "cd packages/gallery && npm run preview",
        "build": "npm run build --workspaces --if-present",
        "lint": "eslint --cache",
        "preversion": "npm run build",
        "version": "node ./bump-version.mjs && git add .",
        "postversion": "git push origin main --tags && run-s publish:*",
        "publish-all": "run-s publish:*",
        "publish:stylesheets": "cd packages/stylesheets && npm publish --access public",
        "publish:core": "cd packages/core && npm publish --access public",
        "publish:nightshade": "cd packages/nightshade && npm publish --access public",
        "publish:palette-generator": "cd packages/palette-generator && npm publish --access public",
        "publish:cli": "cd packages/cli && npm publish --access public",
        "publish:canvas": "cd packages/canvas && npm publish --access public",
        "publish:particle-system": "cd packages/particle-system && npm publish --access public",
        "publish:scroller": "cd packages/scroller && npm publish --access public",
        "publish:util": "cd packages/util && npm publish --access public"
    },
    "pre-commit": [
        "lint"
    ],
    "dependencies": {
        "@nightshadeui/canvas": "./packages/canvas",
        "@nightshadeui/cli": "./packages/cli",
        "@nightshadeui/content-editor": "./packages/content-editor",
        "@nightshadeui/core": "./packages/core",
        "@nightshadeui/gallery": "./packages/gallery",
        "@nightshadeui/palette-generator": "./packages/palette-generator",
        "@nightshadeui/particle-system": "./packages/particle-system",
        "@nightshadeui/scroller": "./packages/scroller",
        "@nightshadeui/stylesheets": "./packages/stylesheets",
        "@nightshadeui/util": "./packages/util"
    },
    "devDependencies": {
        "@fastify/pre-commit": "^2.2.1",
        "@flexent/eslint-config": "^2.0.0",
        "@flexent/eslint-config-vue": "^2.0.0",
        "@types/node": "^24.9.1",
        "@vitejs/plugin-vue": "^6.0.1",
        "eslint": "^9.38.0",
        "lightningcss": "^1.30.2",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.9.3",
        "vite": "^7.1.12",
        "vite-plugin-dts": "^4.5.4"
    },
    "peerDependencies": {
        "vue": "^3.5.22"
    }
}
