{
    "name": "@nightshadeui/workspace",
    "version": "3.1.0",
    "description": "Nightshade workspace",
    "private": true,
    "author": "Boris Okunskiy",
    "license": "ISC",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "run-p dev:*",
        "dev:website": "cd packages/website && npm run dev",
        "preview": "cd packages/website && npm run preview",
        "build": "npm run build --workspaces --if-present",
        "lint": "eslint --cache",
        "test": "npm run test --workspaces --if-present",
        "preversion": "npm run build",
        "version": "bump-version && git add .",
        "postversion": "git push origin HEAD --tags && npm run publish:workspaces",
        "publish:workspaces": "npm publish $(ls-publish-workspaces) --access public"
    },
    "pre-commit": [
        "lint"
    ],
    "dependencies": {
        "@nightshadeui/canvas": "./packages/canvas",
        "@nightshadeui/cli": "./packages/cli",
        "@nightshadeui/components": "./packages/components",
        "@nightshadeui/content-editor": "./packages/content-editor",
        "@nightshadeui/docs": "./packages/docs",
        "@nightshadeui/methodology": "./packages/methodology",
        "@nightshadeui/palette-generator": "./packages/palette-generator",
        "@nightshadeui/particle-system": "./packages/particle-system",
        "@nightshadeui/scroller": "./packages/scroller",
        "@nightshadeui/stylesheets": "./packages/stylesheets",
        "@nightshadeui/util": "./packages/util",
        "@nightshadeui/website": "./packages/website"
    },
    "devDependencies": {
        "@fastify/pre-commit": "^2.2.1",
        "@flexent/eslint-config": "^2.20.1",
        "@flexent/eslint-config-vue": "^2.20.1",
        "@flexent/methodology": "^2.20.1",
        "@flexent/repo-tools": "^2.20.1",
        "@types/node": "^24.9.1",
        "@vitejs/plugin-vue": "^6.0.1",
        "eslint": "^9.38.0",
        "lightningcss": "^1.30.2",
        "npm-run-all": "^4.1.5",
        "typescript": "^5.9.3",
        "vite": "^7.1.12",
        "vite-plugin-dts": "^4.5.4"
    },
    "peerDependencies": {
        "vue": "^3.5.22"
    }
}
